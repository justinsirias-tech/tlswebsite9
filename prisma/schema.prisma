// This is your website-specific Prisma schema file,
// connected to the website database (DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// WEBSITE-SPECIFIC MODELS
// =========================================================================

model Location {
  id                 String   @id @default(uuid())
  slug               String   @unique
  name               String
  name_th            String?
  city               String
  city_th            String?
  type               String
  stars              Int
  totalRooms         Int
  averagePrice       String
  transport          String
  transport_th       String?
  image              String?
  mapLink            String?
  address            String?
  address_th         String?
  website            String?
  article            String?
  article_th         String?
  nearbyAmenities    String[]
  nearbyAmenities_th String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Pricing {
  id           String   @id @default(uuid())
  category     String
  name         String
  name_th      String?
  nonMember    Float
  member       Float?
  unit         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Booking {
  id           String            @id @default(uuid())
  customerName String
  email        String
  phone        String
  pickupDate   DateTime
  service      String
  status       String            @default("PENDING")
  assignedToId String?
  assignedTo   WebsiteAdminUser? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  memberId     String? // Kept as simple column referencing Customer/Member on Webapp DB
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Article {
  id         String   @id @default(uuid())
  title      String
  title_th   String?
  content    String
  content_th String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KeywordQueue {
  id        String   @id @default(uuid())
  keyword   String   @unique
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteAdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("EDITOR")
  permissions  String[]
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("AdminUser")
}

model MembershipRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  tier        String
  term        String
  notes       String?
  dob         String?
  address     String?
  roomNo      String?
  status      String   @default("PENDING")
  startDate   String?
  endDate     String?
  attachments String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PopupTemplate {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("Setting")
}

model Promotion {
  id          String   @id @default(uuid())
  title       String
  title_th    String?
  title_cn    String?
  description String
  desc_th     String?
  desc_cn     String?
  code        String?
  badge       String?
  badge_th    String?
  badge_cn    String?
  imageUrl    String?
  category    String   @default("monthly")
  validUntil  String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE" | "FIXED"
  discountValue  Float     @default(15)
  discountTarget String    @default("ALL") // "ALL" | "DELIVERY"
  minOrderValue  Float?    @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  startDate      DateTime?
  endDate        DateTime?
  expiryDate     String?
  isActive       Boolean   @default(true)
  description    String?
  partnerId      String?
  partner        Partner?  @relation(fields: [partnerId], references: [id])
  sales          PartnerSale[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Partner {
  id               String        @id @default(uuid())
  companyName      String
  contactName      String
  email            String        @unique
  password         String
  phone            String?
  note             String?
  isActive         Boolean       @default(true)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  codes            PromoCode[]
  sales            PartnerSale[]
}

model PartnerSale {
  id            String    @id @default(uuid())
  partnerId     String
  partner       Partner   @relation(fields: [partnerId], references: [id])
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id])
  customerName  String
  customerPhone String
  saleAmount    Float
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  locale    String   @default("en")
  referrer  String?  @default("Direct")
  device    String?  @default("Mobile")
  country   String?  @default("Thailand")
  city      String?  @default("Bangkok")
  createdAt DateTime @default(now())
}
